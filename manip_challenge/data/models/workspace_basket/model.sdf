<?xml version="1.0"?>
<sdf version="1.7">
  <model name="workspace_basket">
    <static>true</static>

    <!-- Bottom -->
    <link name="bottom">
      <pose>0 0 0.00500 0 0 0</pose>

      <visual name="bottom_visual">
        <geometry>
          <box>
            <size>0.5 0.9 0.01</size>
          </box>
        </geometry>
        <material>
          <script>
            <uri>model://workspace_basket/materials/scripts</uri>
            <uri>model://workspace_basket/materials/textures</uri>
            <name>Label/Work_Space</name>
          </script>
        </material>
      </visual>

      <collision name="bottom_collision">
        <geometry>
          <box>
            <size>0.5 0.9 0.01</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <kp>1e+06</kp>
              <kd>1</kd>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
          <friction>
            <ode>
              <mu>1</mu>
              <mu2>1</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <!-- Front wall (+y) -->
    <link name="wall_front">
      <pose>0 0.450000 0.027500 0 0 0</pose>
      <visual name="front_visual">
        <geometry><box><size>0.5 0.005 0.05</size></box></geometry>
      </visual>
      <collision name="front_collision">
        <geometry><box><size>0.5 0.005 0.05</size></box></geometry>
        <surface>
          <contact>
            <ode>
              <kp>1e+06</kp>
              <kd>1</kd>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
          <friction>
            <ode>
              <mu>1</mu>
              <mu2>1</mu2>
            </ode>
          </friction>
        </surface>        
      </collision>
    </link>

    <!-- Back wall (-y) -->
    <link name="wall_back">
      <pose>0 -0.450000 0.027500 0 0 0</pose>
      <visual name="back_visual">
        <geometry><box><size>0.5 0.005 0.05</size></box></geometry>
      </visual>
      <collision name="back_collision">
        <geometry><box><size>0.5 0.005 0.05</size></box></geometry>
        <surface>
          <contact>
            <ode>
              <kp>1e+06</kp>
              <kd>1</kd>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
          <friction>
            <ode>
              <mu>1</mu>
              <mu2>1</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <!-- Left wall (+x) -->
    <link name="wall_left">
      <pose>0.250000 0 0.027500 0 0 0</pose>
      <visual name="left_visual">
        <geometry><box><size>0.005 0.9 0.05</size></box></geometry>
      </visual>
      <collision name="left_collision">
        <geometry><box><size>0.005 0.9 0.05</size></box></geometry>
        <surface>
          <contact>
            <ode>
              <kp>1e+06</kp>
              <kd>1</kd>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
          <friction>
            <ode>
              <mu>1</mu>
              <mu2>1</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <!-- Right wall (-x) -->
    <link name="wall_right">
      <pose>-0.250000 0 0.027500 0 0 0</pose>
      <visual name="right_visual">
        <geometry><box><size>0.005 0.9 0.05</size></box></geometry>
      </visual>
      <collision name="right_collision">
        <geometry><box><size>0.005 0.9 0.05</size></box></geometry>
        <surface>
          <contact>
            <ode>
              <kp>1e+06</kp>
              <kd>1</kd>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
          <friction>
            <ode>
              <mu>1</mu>
              <mu2>1</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

  </model>
</sdf>
