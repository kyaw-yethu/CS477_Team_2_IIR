<?xml version="1.0"?>
<sdf version="1.7">
  <model name="storage_b_basket">
    <static>true</static>

    <!-- Bottom -->
    <link name="bottom">
      <pose>0 0 0.002500 0 0 0</pose>

      <visual name="bottom_visual">
        <geometry>
          <box>
            <size>0.35 0.45 0.005</size>
          </box>
        </geometry>
        <material>
          <script>
            <uri>model://storage_b_basket/materials/scripts</uri>
            <uri>model://storage_b_basket/materials/textures</uri>
            <name>Label/Storage_B</name>
          </script>
        </material>
      </visual>

      <collision name="bottom_collision">
        <geometry>
          <box>
            <size>0.35 0.45 0.005</size>
          </box>
        </geometry>
      </collision>
    </link>

    <!-- Front wall (+y) -->
    <link name="wall_front">
      <pose>0 0.225000 0.027500 0 0 0</pose>
      <visual name="front_visual">
        <geometry><box><size>0.35 0.005 0.05</size></box></geometry>
      </visual>
      <collision name="front_collision">
        <geometry><box><size>0.35 0.005 0.05</size></box></geometry>
      </collision>
    </link>

    <!-- Back wall (-y) -->
    <link name="wall_back">
      <pose>0 -0.225000 0.027500 0 0 0</pose>
      <visual name="back_visual">
        <geometry><box><size>0.35 0.005 0.05</size></box></geometry>
      </visual>
      <collision name="back_collision">
        <geometry><box><size>0.35 0.005 0.05</size></box></geometry>
      </collision>
    </link>

    <!-- Left wall (+x) -->
    <link name="wall_left">
      <pose>0.175000 0 0.027500 0 0 0</pose>
      <visual name="left_visual">
        <geometry><box><size>0.005 0.45 0.05</size></box></geometry>
      </visual>
      <collision name="left_collision">
        <geometry><box><size>0.005 0.45 0.05</size></box></geometry>
      </collision>
    </link>

    <!-- Right wall (-x) -->
    <link name="wall_right">
      <pose>-0.175000 0 0.027500 0 0 0</pose>
      <visual name="right_visual">
        <geometry><box><size>0.005 0.45 0.05</size></box></geometry>
      </visual>
      <collision name="right_collision">
        <geometry><box><size>0.005 0.45 0.05</size></box></geometry>
      </collision>
    </link>

  </model>
</sdf>
